# Backend environment variables. Copy to .env and fill in for real runs;
# every integration below degrades gracefully to a safe ESCALATE/fallback
# path if its key is unset, so the demo works without any of them.

# Fireworks — referral feature extraction + PA packet sentence generation.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# ElevenLabs — voice intake line + outbound payer IVR call.
ELEVENLABS_API_KEY=

# Daytona — sandboxed referral document parsing (OCR/PDF decode).
# With a key set, ALL referral parsing runs in a throwaway, network-blocked
# Daytona sandbox; any sandbox error escalates to a human (never local decode).
# Without a key, the demo falls back to unsandboxed local decode (loudly logged).
DAYTONA_API_KEY=dtn_9a8115a3c05b21f262728e02afd-d6aa6b647dc3b02cda114c88e8680085a1b8b
# Optional: prebuilt image/snapshot ref to skip the first-run image build.
# DAYTONA_SANDBOX_IMAGE=
# Optional tuning (seconds): in-sandbox exec cap, and first-build create cap.
# DAYTONA_SANDBOX_TIMEOUT_S=60
# DAYTONA_SANDBOX_CREATE_TIMEOUT_S=180dtn_9a8115a3c05b21f262728e02afdd6aa6b647dc3b02cda114c88e8680085a1b8b

# Braintrust — eval logging (evals/run.py). Local eval summary still works
# without this; it just skips the remote experiment log.
BRAINTRUST_API_KEY=

PORT=8000
