# Copy this file to .env.local for local development (.env.local is
# gitignored — never commit it).
#
# NEXT_PUBLIC_* vars are shipped to the browser. Never put secrets here —
# Fireworks/ElevenLabs/Braintrust/Daytona keys live server-side only, on the
# FastAPI backend, not in this app.

# Base URL of the Meridian FastAPI backend. In production this is the
# Vercel-configured tunnel/host (see CLAUDE.md's Deployment section).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Flags the UI as demo-only. Keep true everywhere this app is deployed —
# there is no production, non-demo mode for this project.
NEXT_PUBLIC_DEMO_MODE=true
